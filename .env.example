# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must never be committed.

# --- Weather providers ---
OPENWEATHER_API_KEY=
WORLDTIDES_API_KEY=
STORMGLASS_API_KEY=

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DISPATCH_TOKEN=
LINE_DEFAULT_LAT=13.7563
LINE_DEFAULT_LON=100.5018
LINE_DEFAULT_LOCATION_NAME=Bangkok

# --- Client-exposed ---
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put a secret here.
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_WORLDTIDES_API_KEY=
NEXT_PUBLIC_OPENWEATHER_API_KEY=
